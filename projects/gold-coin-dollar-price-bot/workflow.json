      "id": "http_price",
      "name": "Get Live Prices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        520,
        180
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_WITH_BRSAPI_CRED",
          "name": "BrsApi Key"
        }
