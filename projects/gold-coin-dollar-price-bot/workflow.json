    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// قیمت لحظه‌ای بازار را به یک پیام فارسی تبدیل می‌کند\nconst res = $input.first().json;\n\n// هر آرایه‌ای در پاسخ API را جمع می‌کنیم تا به ساختار دقیق آن وابسته نباشیم\nconst buckets = [];\nif (Array.isArray(res)) {\n  buckets.push(res);\n} else if (res && typeof res === 'object') {\n  for (const key of Object.keys(res)) {\n    if (Array.isArray(res[key])) buckets.push(res[key]);\n  }\n}\nconst flat = buckets.flat();\n\nconst priceOf = (keywords) => {\n  const row = flat.find((r) => {\n    const name = String(r.name || r.title || r.symbol || '');\n    return keywords.some((k) => name.includes(k));\n  });\n  if (!row) return null;\n  const raw = row.price ?? row.value ?? row.sell ?? row.p;\n  const num = Number(String(raw).replace(/[^\\d.]/g, ''));\n  return Number.isFinite(num) ? num : null;\n};\n\nconst fmt = (n) => (n === null ? '—' : n.toLocaleString('fa-IR'));\n\nconst rows = [\n  ['🟡 طلای ۱۸ عیار (گرم)', priceOf(['طلای 18', 'طلای ۱۸', '18 عیار', '۱۸ عیار'])],\n  ['🪙 سکه امامی', priceOf(['امامی', 'سکه امامی'])],\n  ['🪙 نیم سکه', priceOf(['نیم'])],\n  ['🪙 ربع سکه', priceOf(['ربع'])],\n  ['💵 دلار آمریکا', priceOf(['دلار'])],\n  ['💶 یورو', priceOf(['یورو'])],\n];\n\nconst now = new Date().toLocaleString('fa-IR', { timeZone: 'Asia/Tehran' });\nlet message = '📊 قیمت لحظه‌ای بازار\\n\\n';\nfor (const [label, price] of rows) {\n  message += label + ': ' + fmt(price) + ' تومان\\n';\n}\nmessage += '\\n🕒 به‌روزرسانی: ' + now;\nmessage += '\\n\\nℹ️ برای ثبت هشدار بنویسید: هشدار سکه 50000000';\n\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nreturn [{ json: { message, chatId: String(chatId) } }];\n"
      },
      "id": "code_price",
      "name": "Build Price Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        180
      ]
