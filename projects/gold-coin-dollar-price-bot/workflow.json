      "id": "http_currency",
      "name": "Get Currency Prices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        670,
        0
      ],
      "credentials": {
        "httpQueryAuth": {
