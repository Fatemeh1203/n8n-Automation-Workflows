    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// قیمت فعلی را با هشدارهای ذخیره‌شده مقایسه می‌کند\n// و فقط هشدارهای فعال‌شده را به خروجی می‌فرستد\nconst res = $('Get Prices (Alerts)').first().json;\n\nconst buckets = [];\nif (Array.isArray(res)) {\n  buckets.push(res);\n} else if (res && typeof res === 'object') {\n  for (const key of Object.keys(res)) {\n    if (Array.isArray(res[key])) buckets.push(res[key]);\n  }\n}\nconst flat = buckets.flat();\n\nconst priceOf = (keywords) => {\n  const row = flat.find((r) => {\n    const name = String(r.name || r.title || r.symbol || '');\n    return keywords.some((k) => name.includes(k));\n  });\n  if (!row) return null;\n  const raw = row.price ?? row.value ?? row.sell ?? row.p;\n  const num = Number(String(raw).replace(/[^\\d.]/g, ''));\n  return Number.isFinite(num) ? num : null;\n};\n\nconst priceByAsset = {\n  coin_emami: priceOf(['امامی', 'سکه امامی']),\n  gold_18: priceOf(['طلای 18', 'طلای ۱۸', '18 عیار', '۱۸ عیار']),\n  usd: priceOf(['دلار']),\n  eur: priceOf(['یورو']),\n};\n\nconst out = [];\nfor (const item of $input.all()) {\n  const a = item.json;\n  const current = priceByAsset[a.asset];\n  if (current === null || current === undefined) continue;\n  const target = Number(a.target);\n  const hit = a.direction === 'below' ? current <= target : current >= target;\n  if (!hit) continue;\n  out.push({\n    json: {\n      alertId: a.id,\n      chatId: String(a.chatId),\n      assetLabel: a.assetLabel,\n      target,\n      current,\n      direction: a.direction,\n    },\n  });\n}\nreturn out;\n"
      },
