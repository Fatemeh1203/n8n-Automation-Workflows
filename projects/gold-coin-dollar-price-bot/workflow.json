    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// دستور هشدار کاربر را به یک رکورد ساختارمند تبدیل می‌کند\n// نمونه‌ها: «هشدار سکه 50000000» یا «هشدار دلار 60000 پایین»\nconst text = String($json.message.text || '');\nconst chatId = $json.message.chat.id;\n\n// اعداد فارسی را به لاتین تبدیل و جداکننده‌ها را حذف می‌کنیم\nconst toEn = (s) => s.replace(/[۰-۹]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));\nconst numbers = (text.match(/[\\d۰-۹]{2,}/g) || [])\n  .map((s) => Number(toEn(s)))\n  .filter((n) => Number.isFinite(n) && n > 0);\nconst target = numbers.length ? Math.max(...numbers) : 0;\n\nconst assets = [\n  { key: 'coin_emami', label: 'سکه امامی', kw: ['امامی', 'سکه'] },\n  { key: 'gold_18', label: 'طلای ۱۸ عیار', kw: ['طلا', '18', '۱۸'] },\n  { key: 'usd', label: 'دلار', kw: ['دلار'] },\n  { key: 'eur', label: 'یورو', kw: ['یورو'] },\n];\nconst found = assets.find((a) => a.kw.some((k) => text.includes(k))) || assets[0];\n\n// جهت هشدار: پایین/کمتر/زیر یعنی نزولی، در غیر این صورت صعودی\nconst direction =\n  text.includes('پایین') || text.includes('کمتر') || text.includes('زیر')\n    ? 'below'\n    : 'above';\n\nreturn [\n  {\n    json: {\n      chatId: String(chatId),\n      asset: found.key,\n      assetLabel: found.label,\n      target,\n      direction,\n      createdAt: new Date().toISOString(),\n      valid: target > 0,\n    },\n  },\n];\n"
      },
