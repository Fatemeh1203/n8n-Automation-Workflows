    { "id": "6", "name": "نرمال‌سازی متن", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1060, 420],
      "parameters": { "jsCode": "function normalizePersian(input) {\n  if (!input) return '';\n  const p='۰۱۲۳۴۵۶۷۸۹', a='٠١٢٣٤٥٦٧٨٩';\n  return String(input).replace(/ي/g,'ی').replace(/ك/g,'ک').replace(/[‌\\s]+/g,' ')\n    .replace(/[۰-۹]/g,d=>String(p.indexOf(d))).replace(/[٠-٩]/g,d=>String(a.indexOf(d))).trim();\n}\nreturn $input.all().flatMap(item => (item.json.result || []).map(u => {\n  const msg = u.message || {};\n  const cb = u.callback_query;\n  const chatId = (msg.chat && msg.chat.id) || (cb && cb.from && cb.from.id);\n  const rawText = (msg.text || (cb && cb.data) || '').toString();\n  return { json: { update_id: u.update_id, chat_id: chatId, normalized_text: normalizePersian(rawText), is_callback: !!cb } };\n}));" } },
    { "id": "7", "name": "جستجوی ولی", "type": "n8n-nodes-base.postgres", "typeVersion": 2, "position": [1300, 420],
