      "credentials": { "postgres": { "id": "school-postgres", "name": "PostgreSQL مدرسه" } } },
    { "id": "8", "name": "ترکیب وضعیت احراز هویت", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1540, 420],
      "parameters": { "jsCode": "return $input.all().map((item, i) => {\n  const trigger = $('نرمال‌سازی متن').all()[i].json;\n  const row = item.json;\n  return { json: { ...trigger, parent_id: row.id || null, student_id: row.student_id || null, is_verified: !!row.verified_at } };\n});" } },
    { "id": "9", "name": "بررسی احراز هویت", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1780, 420],
      "parameters": { "conditions": { "conditions": [
        { "leftValue": "={{$json.is_verified}}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
      ] } } },

    { "id": "10", "name": "بررسی قفل", "type": "n8n-nodes-base.postgres", "typeVersion": 2, "position": [2020, 200],
