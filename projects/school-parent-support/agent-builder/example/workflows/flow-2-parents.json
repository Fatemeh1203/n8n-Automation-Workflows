    { "id": "11", "name": "ترکیب وضعیت قفل", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2260, 200],
      "parameters": { "jsCode": "return $input.all().map((item, i) => {\n  const trigger = $('ترکیب وضعیت احراز هویت').all()[i].json;\n  const row = item.json;\n  const locked = row.attempt_count >= 3 && row.last_attempt_at && (Date.now() - new Date(row.last_attempt_at).getTime()) < 3600000;\n  const looksLikeCode = /^[A-Za-z0-9]{4,8}$/.test(trigger.normalized_text || '');\n  return { json: { ...trigger, is_locked: !!locked, looks_like_code: looksLikeCode } };\n});" } },
