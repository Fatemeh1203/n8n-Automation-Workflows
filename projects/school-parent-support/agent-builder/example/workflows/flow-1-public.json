    },
    {
      "id": "6", "name": "نرمال‌سازی متن", "type": "n8n-nodes-base.code",
      "typeVersion": 2, "position": [1140, 420],
      "parameters": {
        "jsCode": "function normalizePersian(input) {\n  if (!input) return '';\n  const p = '۰۱۲۳۴۵۶۷۸۹', a = '٠١٢٣٤٥٦٧٨٩';\n  return String(input)\n    .replace(/ي/g, 'ی').replace(/ك/g, 'ک')\n    .replace(/[‌\\s]+/g, ' ')\n    .replace(/[۰-۹]/g, d => String(p.indexOf(d)))\n    .replace(/[٠-٩]/g, d => String(a.indexOf(d)))\n    .trim();\n}\nconst staticData = $getWorkflowStaticData('node');\nreturn $input.all().flatMap(item => (item.json.result || []).map(u => {\n  const msg = u.message || {};\n  const chatId = msg.chat && msg.chat.id;\n  const rawText = (msg.text || (u.callback_query && u.callback_query.data) || '').toString();\n  const awaiting = staticData['awaiting_phone_' + chatId] === true;\n  return { json: {\n    update_id: u.update_id, chat_id: chatId,\n    normalized_text: normalizePersian(rawText), awaiting_phone: awaiting\n  } };\n}));"
      }
    },
    {
      "id": "7", "name": "مسیر پیام", "type": "n8n-nodes-base.switch",
      "typeVersion": 3, "position": [1380, 420],
      "parameters": { "rules": { "values": [
        { "outputKey": "منو", "conditions": { "conditions": [
          { "leftValue": "={{$json.normalized_text}}", "rightValue": "شهریه|ثبت نام|درباره ی مدرسه|آدرس و ساعت کاری", "operator": { "type": "string", "operation": "regex" } }
        ] } },
        { "outputKey": "سؤال دیگر", "conditions": { "conditions": [
          { "leftValue": "={{$json.normalized_text}}", "rightValue": "سؤال دیگر", "operator": { "type": "string", "operation": "equals" } }
        ] } },
        { "outputKey": "شماره تلفن", "conditions": { "conditions": [
          { "leftValue": "={{$json.awaiting_phone}}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
        ] } }
      ], "fallbackOutput": "extra" } }
    },
    {
      "id": "8", "name": "خواندن FAQ", "type": "n8n-nodes-base.postgres",
