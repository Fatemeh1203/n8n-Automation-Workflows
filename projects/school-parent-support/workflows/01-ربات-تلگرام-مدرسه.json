    {"id":"c2582095-f856-4bac-bde7-da2a3a8d2ffe","name":"تجزیه دستور کارمند","type":"n8n-nodes-base.code","typeVersion":2,"position":[1100,100],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const j = $input.first().json;\nconst t = (j.rawText || '').trim();\nlet cmd = 'help', ticketId = null, replyText = '';\nlet m = t.match(/^\\/reply\\s+(\\d+)\\s+([\\s\\S]+)/);\nif (m) { cmd = 'reply'; ticketId = parseInt(m[1], 10); replyText = m[2].trim(); }\nelse { m = t.match(/^\\/close\\s+(\\d+)/); if (m) { cmd = 'close'; ticketId = parseInt(m[1], 10); } }\nj.staffCmd = cmd; j.ticketId = ticketId; j.replyText = replyText;\nreturn [{ json: j }];"}},
