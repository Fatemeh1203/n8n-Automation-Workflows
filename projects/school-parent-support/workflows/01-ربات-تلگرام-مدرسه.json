    {"id":"a7b77084-ffb5-4802-b70e-26cf48cdefc3","name":"استخراج و نرمال‌سازی ورودی","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,400],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"function normalizeFa(s) {\n  if (s === undefined || s === null) return '';\n  let t = String(s);\n  t = t.replace(/\\u064A/g, '\\u06CC').replace(/\\u0643/g, '\\u06A9');\n  t = t.replace(/[\\u200C\\u200B]/g, ' ');\n  const faDigits = '۰۱۲۳۴۵۶۷۸۹';\n  const arDigits = '٠١٢٣٤٥٦٧٨٩';\n  t = t.replace(/[۰-۹]/g, function (d) { return String(faDigits.indexOf(d)); });\n  t = t.replace(/[٠-٩]/g, function (d) { return String(arDigits.indexOf(d)); });\n  t = t.replace(/\\s+/g, ' ').trim();\n  return t;\n}\nconst item = $input.first().json;\nconst isCallback = !!item.callback_query;\nconst msg = isCallback ? item.callback_query.message : item.message;\nconst chatId = msg && msg.chat ? msg.chat.id : (isCallback ? item.callback_query.from.id : null);\nconst messageId = msg ? msg.message_id : null;\nconst callbackData = isCallback ? (item.callback_query.data || '') : '';\nconst rawText = isCallback ? '' : (item.message && item.message.text ? item.message.text : '');\nreturn [{\n  json: {\n    chatId: chatId,\n    messageId: messageId,\n    updateId: item.update_id,\n    isCallback: isCallback,\n    callbackData: callbackData,\n    rawText: rawText,\n    text: normalizeFa(rawText)\n  }\n}];"}},
    {"id":"d439e8fe-f82e-4117-822d-89922a00fd28","name":"دریافت نقش و نشست کاربر","type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[440,400],"parameters":{"resource":"database","operation":"executeQuery","query":"SELECT s.id AS staff_id, s.category AS staff_category, p.student_id AS parent_student_id, p.verified_at AS parent_verified_at, st.name AS student_name, st.grade AS student_grade, st.class AS student_class, COALESCE(ses.state, 'idle') AS session_state, COALESCE(ses.temp_data::text, '{}') AS session_temp_data FROM (SELECT $1::bigint AS chat_id) AS input LEFT JOIN staff s ON s.chat_id = input.chat_id LEFT JOIN parents p ON p.chat_id = input.chat_id AND p.verified_at IS NOT NULL LEFT JOIN students st ON st.id = p.student_id LEFT JOIN sessions ses ON ses.chat_id = input.chat_id;","options":{"queryReplacement":"={{ [ $json.chatId ] }}"}},"credentials":{"postgres":{"id":"__SET_ME__","name":"دیتابیس داخلی مدرسه"}}},
    {"id":"fe81e777-7bcd-4a61-8cda-3c215ef81b0b","name":"تعیین نقش، وضعیت و نرمال‌سازی","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,400],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const input = $('استخراج و نرمال‌سازی ورودی').item.json;\nconst row = $input.first().json;\nlet role = 'guest';\nif (row.staff_id) role = 'staff';\nelse if (row.parent_student_id) role = 'parent';\nlet tempData = {};\ntry { tempData = JSON.parse(row.session_temp_data || '{}'); } catch (e) { tempData = {}; }\nreturn [{\n  json: {\n    chatId: input.chatId,\n    messageId: input.messageId,\n    isCallback: input.isCallback,\n    callbackData: input.callbackData,\n    rawText: input.rawText,\n    text: input.text,\n    role: role,\n    staffId: row.staff_id,\n    staffCategory: row.staff_category,\n    studentId: row.parent_student_id,\n    studentName: row.student_name,\n    studentGrade: row.student_grade,\n    studentClass: row.student_class,\n    sessionState: row.session_state || 'idle',\n    sessionTempCategory: tempData.category || ''\n  }\n}];"}},
