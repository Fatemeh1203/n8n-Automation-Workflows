    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst count = rows.length;\nconst totalSum = rows.reduce((s, r) => s + Number(r.total || 0), 0);\nconst feeSum = rows.reduce((s, r) => s + Number(r.makingFee || 0) + Number(r.profit || 0), 0);\nconst day = rows[0]?.day || new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Tehran' });\nreturn [{ json: { day, count, totalSum, feeSum } }];"
      },
